// gitropolis.dev on Cloudflare: the web/ pages as static assets, one Worker route for cities,
// a small pool of containers that clone and scan, and an R2 bucket that keeps every city it built.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitropolis",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../web",
    "binding": "ASSETS",
    // /owner/repo isn't a file: serve index.html and let the page ask the API for its city
    "not_found_handling": "single-page-application",
    // the API, repo pages (their link-preview tags) and README badges; everything else is served straight from the assets
    "run_worker_first": ["/api/*", "/*/*", "!/vendor/*"]
  },
  "containers": [
    {
      "class_name": "Scanner",
      "image": "./container/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": { "bindings": [{ "name": "SCANNER", "class_name": "Scanner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scanner"] }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "CITIES", "bucket_name": "gitropolis-cities" }],
  "ratelimits": [{ "name": "SCAN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "gitropolis.dev", "custom_domain": true },
    { "pattern": "www.gitropolis.dev", "custom_domain": true }
  ]
}
